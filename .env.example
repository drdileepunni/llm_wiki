# CDS Pipeline — environment variables
# On Cloud Run these come from Secret Manager or --set-env-vars; no file needed.
# For local dev, copy to .env and fill in values.

GCS_BUCKET=cds-pipeline-ops
BQ_SERVICE_URL=https://bigquery-service-971880579407.us-central1.run.app
MODEL=gemini-2.0-flash-lite
REASONING_MODEL=gemini-2.0-flash-lite
WIKI_ROOT=/app

# Secrets — loaded from Secret Manager on Cloud Run.
# For local dev only:
GOOGLE_API_KEY=your-google-api-key
RADAR_READ_SERVICE_ACCOUNT={"type":"service_account",...}
